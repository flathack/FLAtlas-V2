  "title": "Adding factions to the game",
  "summary": "Which Freelancer files are involved in a new faction and how they relate to each other.",
  "category": "Modding Basics",
  "tags": ["faction", "initialworld", "empathy", "ids", "npc", "loadouts"],
  "contexts": ["faction-editor", "npc-editor", "system-editor"],
