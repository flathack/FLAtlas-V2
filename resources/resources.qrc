<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/icons">
        <file alias="FLAtlas-V2-ICON.png">images/FLAtlas-V2-ICON.png</file>
        <file alias="FLAtlas-V2-ICON.ico">images/FLAtlas-V2-ICON.ico</file>
    </qresource>
    <qresource prefix="/images">
        <file alias="Splash-Screen.png">images/Splash-Screen.png</file>
        <file alias="Splash-Screen-Blue.png">images/Splash-Screen-Blue.png</file>
        <file alias="star-background.png">images/star-background.png</file>
        <file alias="wallpaper-dark.png">images/wallpaper-dark.png</file>
        <file alias="wallpaper-white.png">images/wallpaper-white.png</file>
    </qresource>
    <qresource prefix="/help">
        <!-- TODO: Add help HTML files -->
    </qresource>
    <qresource prefix="/data">
        <!-- TODO: Add static data files -->
    </qresource>
    <qresource prefix="/languages">
        <file alias="index.json">languages/index.json</file>
        <file alias="de.json">languages/de.json</file>
    </qresource>
</RCC>
